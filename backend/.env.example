PORT=4000
NODE_ENV=development

# Anthropic API — when set, twice-daily smart tip briefings are generated by Claude.
# When unset, the stub provider returns templated text.
# ANTHROPIC_API_KEY=sk-ant-...

# Web Push VAPID keys — generate once with:
#   node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k);"
# Public key is also exposed to the frontend at build time; private key stays server-side.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
