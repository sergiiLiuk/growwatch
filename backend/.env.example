PORT=4000
NODE_ENV=development

# Anthropic API — when set, twice-daily smart tip briefings are generated by Claude.
# When unset, the stub provider returns templated text.
# ANTHROPIC_API_KEY=sk-ant-...

# Web Push VAPID keys — generate once with:
#   node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k);"
# Public key is also exposed to the frontend at build time; private key stays server-side.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Resend (transactional email — password reset). Without the API key the
# sender falls back to logging the reset link to console (dev only).
# Domain must be verified in Resend before the FROM address will deliver.
# RESEND_API_KEY=re_...
# FROM_EMAIL=GrowWatch <no-reply@growwatch.app>

# Public URL of the frontend, used to build absolute links (e.g. password reset).
# FRONTEND_URL=https://www.growwatch.app

# Shared secret for the external cron tick endpoint (cron-job.org etc.).
# CRON_SECRET=

# Google Sign-In — Web Client ID from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs > Web application).
# Used to verify ID tokens posted to POST /auth/google. The same value is
# exposed to the frontend at build time so the GSI button can request a
# token. Leave unset to disable Google sign-in.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# MQTT broker (HiveMQ Cloud — set in Railway env in prod)
MQTT_BROKER_URL=mqtts://example.hivemq.cloud:8883
MQTT_PUBLIC_URL=mqtts://example.hivemq.cloud:8883
MQTT_SERVER_PASSWORD=devpassword
MQTT_PUBLISHER_USERNAME=shelly-publisher
MQTT_PUBLISHER_PASSWORD=devpasswordpub
